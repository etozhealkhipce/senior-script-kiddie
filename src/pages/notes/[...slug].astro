---
import { NoteContent } from "@/components/dynamic/notes-page/note-content";
import type { NoteApiData } from "@/components/dynamic/notes-page/types";
import Layout from "@/layouts/layout.astro";
import { formatDate } from "@/lib/format-date";
import { resolveUploads } from "@/lib/resolve-uploads";

const API_URL = process.env.API_URL ?? "http://localhost:3000";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/404");
}

let note: NoteApiData | null = null;
try {
  const res = await fetch(`${API_URL}/notes/${slug}`);
  if (res.status === 404) {
    return Astro.redirect("/404");
  }
  if (res.ok) {
    note = await res.json();
  }
} catch (e) {
  console.error(`[notes/${slug}] Failed to fetch note:`, e);
  return Astro.redirect("/404");
}

if (!note) {
  return Astro.redirect("/404");
}

const { title, content, tags, createdAt, preview } = note;
const resolvedContent = resolveUploads(content, API_URL);
const date = formatDate(createdAt);

// JSON-LD for blog post structured data
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description: preview,
  author: { "@type": "Person", name: "Ilya Dyomin" },
  datePublished: createdAt,
  keywords: tags?.join(", ") ?? "",
  url: Astro.url.href,
});
---

<Layout
  title={title}
  description={preview}
  ogType="article"
  keywords={tags ?? []}
  publishedAt={createdAt}
>
  <script type="application/ld+json" set:html={jsonLd} slot="head" />
  <NoteContent
    client:load
    title={title}
    content={resolvedContent}
    date={date}
    tags={tags}
  />
</Layout>
